# Variables de entorno para el backend
# Copia este archivo a ".env" (NUNCA subas el .env al repositorio)

# Puerto del servidor
PORT=5000

# Entorno: development | production
NODE_ENV=development

# MongoDB
# Desarrollo: base local. Para producción usa la cadena de conexión de Atlas
# (Atlas -> Database -> Connect -> Drivers) y pégala SOLO en las variables
# de entorno de Render, nunca en archivos del repositorio.
MONGO_URI=mongodb://localhost:27017/cultura_local

# JWT: OBLIGATORIO, mínimo 32 caracteres. El servidor no arranca sin él.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (frontend). Varias URLs separadas por comas, sin "/" final.
# Desarrollo:  http://localhost:5173
# Producción:  https://culturalocal.cl,https://www.culturalocal.cl
CORS_ORIGIN=http://localhost:5173

# Número de proxies delante de la app (Render = 1; Render + Cloudflare = 2)
TRUST_PROXY=1

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeder de usuarios (opcional). Si se dejan vacías se generan contraseñas aleatorias.
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=